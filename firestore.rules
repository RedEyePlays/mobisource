rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Single role for now: an internal staff account. No other roles exist yet.
    function isStaff() {
      return request.auth != null && request.auth.token.staff == true;
    }

    match /skus/{skuCode} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /donors/{donorId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /teardownProfiles/{profileId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /stockItems/{itemId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /teardowns/{teardownId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /buyers/{buyerId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /salesOrders/{orderId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /bulkStock/{skuCode} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /bulkReceipts/{receiptId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /supplierSkuMap/{mapId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Deny-all default for anything not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
