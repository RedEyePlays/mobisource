rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Single role for now: an internal staff account. No other roles exist yet.
    function isStaff() {
      return request.auth != null && request.auth.token.staff == true;
    }

    match /skus/{skuCode} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /donors/{donorId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /teardownProfiles/{profileId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Deny-all default. Every other collection (bulkStock, stockItems,
    // teardowns, buyers, salesOrders, ...) gets explicit rules when its
    // phase lands.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
