{
  "name": "mobisource",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest run src functions/src",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mobisource \"vitest run tests/rules\"",
    "seed:emulator": "firebase emulators:exec --only firestore --project demo-mobisource \"node scripts/seed.js\"",
    "emulators": "firebase emulators:start --only auth,firestore,functions --project demo-mobisource"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "firebase-admin": "^14.0.0",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
